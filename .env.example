# ROOTRANGE Workstation Environment Configuration
# API keys are only needed if routing to external LLM providers.
# By default, ROOTRANGE runs 100% locally with simulated heuristics.

VITE_APP_NAME=ROOTRANGE
VITE_APP_VERSION=1.0.0
VITE_ENABLE_AUDIO=true
VITE_OFFLINE_MODE=true

# Optional: External AI Provider Endpoint (e.g., Ollama or custom proxy)
# VITE_AI_PROVIDER_URL=http://localhost:11434
# VITE_AI_PROVIDER_MODEL=llama3
